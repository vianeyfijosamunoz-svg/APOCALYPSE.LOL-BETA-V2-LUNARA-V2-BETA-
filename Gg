local function isEnemy(player)
    if player == LocalPlayer then return false end
    if not ESPTeamCheck then return true end
    if SpectateController then
        local success, duel = pcall(function() return SpectateController.CurrentDuelSubject end)
        if success and duel then
            local localDueler = duel:GetDueler(LocalPlayer)
            local localTeam = localDueler and localDueler:Get("TeamID") or nil
            if localTeam and duel.Duelers then
                for _, dueler in ipairs(duel.Duelers) do
                    if dueler.Player == player then
                        local team = dueler:Get("TeamID")
                        return team ~= localTeam
                    end
                end
            end
        end
    end
    local pTeam = player:GetAttribute("TeamID")
    local lTeam = LocalPlayer:GetAttribute("TeamID")
    if pTeam and lTeam then
        return pTeam ~= lTeam
    end
    return true
end

local function isTargetValid(player)
    if not player or not isEnemy(player) then return false end
    local pChar = player.Character
    if not pChar then return false end
    local pRoot = pChar:FindFirstChild("HumanoidRootPart")
    local pHead = pChar:FindFirstChild("Head")
    local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
    if not (pRoot and pHead and pHum and pHum.Health > 0) then return false end
    return true
end

local function hasValidWeaponAndObjectID()
    if not FighterController or not FighterController.LocalFighter then return false end
    local item = FighterController.LocalFighter.EquippedItem
    if not item then return false end
    local success, objId = pcall(function() return item:Get("ObjectID") end)
    if not success or not objId then return false end
    return true
end

local function getClosestTarget(maxDistance)
    maxDistance = maxDistance or math.huge
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil, nil end

    local bestPlayer, bestRoot, bestHead = nil, nil, nil
    local bestScore = math.huge

    for _, player in ipairs(plrs:GetPlayers()) do
        if isTargetValid(player) then
            local pChar = player.Character
            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
            local pHead = pChar:FindFirstChild("Head")
            local pHum = pChar:FindFirstChildWhichIsA("Humanoid")

            if pRoot and pHead and pHum then
                local dist = (myRoot.Position - pRoot.Position).Magnitude
                if dist <= maxDistance then
                    local score = dist

                    if isRagebotOn and AutoPrioritized then
                        if PriorityMode == "VALUE (HP)" then
                            score = pHum.Health
                        elseif PriorityMode == "CHARACTER" then
                            local history = playerVelocityHistory[player]
                            local currentVel = pRoot.AssemblyLinearVelocity
                            local strangeScore = dist

                            if history then
                                local speedDiff = (currentVel - history.lastVelocity).Magnitude
                                local directionChange = 0
                                if history.lastVelocity.Magnitude > 5 then
                                    directionChange = (1 - currentVel.Unit:Dot(history.lastVelocity.Unit)) * 50
                                end
                                if speedDiff > 40 or directionChange > 25 then
                                    strangeScore = dist * 0.3
                                end
                            end
                            score = strangeScore
                            playerVelocityHistory[player] = {
                                lastVelocity = currentVel,
                                lastPosition = pRoot.Position
                            }
                        end
                    end

                    if score < bestScore then
                        bestScore = score
                        bestPlayer = player
                        bestRoot = pRoot
                        bestHead = pHead
                    end
                end
            end
        end
    end

    if bestPlayer and bestPlayer ~= lastPrioritizedPlayer and isRagebotOn and AutoPrioritized and PriorityMode ~= "Closest" then
        if tick() - lastNotifyTime > 1.2 then
            lastNotifyTime = tick()
            lastPrioritizedPlayer = bestPlayer
            if PriorityMode == "VALUE (HP)" then
                local hp = math.floor(bestPlayer.Character:FindFirstChildWhichIsA("Humanoid").Health)
                Library:Notify("AUTO PRIORIZED (" .. hp .. " HP) - Low Health", 3)
            elseif PriorityMode == "CHARACTER" then
                Library:Notify("AUTO PRIORIZED (" .. bestPlayer.Name .. ")", 3)
            end
        end
    elseif not bestPlayer then
        lastPrioritizedPlayer = nil
    end

    return bestPlayer, bestRoot, bestHead
end

local function bringAllToMe()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local targetCFrame = rootPart.CFrame

    for _, player in ipairs(plrs:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemyChar = player.Character
            if enemyChar then
                local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
                if enemyRoot then
                    for _, part in ipairs(enemyChar:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                    enemyRoot.CFrame = targetCFrame
                end
            end
        end
    end
end

local function createDrawing(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props or {}) do
        d[k] = v
    end
    return d
end

local function removeDrawings(player)
    if Drawings[player] then
        for _, d in pairs(Drawings[player]) do
            pcall(function() d:Remove() end)
        end
        Drawings[player] = nil
    end
    if Highlights[player] then
        pcall(function() Highlights[player]:Destroy() end)
        Highlights[player] = nil
    end
end

local function updateESP()
    if not ESPEnabled then
        for player, _ in pairs(Drawings) do
            removeDrawings(player)
        end
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(plrs:GetPlayers()) do
        if player == LocalPlayer then
            removeDrawings(player)
            continue
        end

        if not isTargetValid(player) then
            removeDrawings(player)
            continue
        end

        local char = player.Character
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")

        if not root or not head or not humanoid then
            removeDrawings(player)
            continue
        end

        local dist = myRoot and (myRoot.Position - root.Position).Magnitude or 0
        if dist > ESPMaxDistance then
            removeDrawings(player)
            continue
        end

        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)

        if not Drawings[player] then
            Drawings[player] = {
                Box = createDrawing("Square", {Thickness = 1, Filled = false, Color = ESPBoxColor, Visible = false}),
                Name = createDrawing("Text", {Size = 14, Center = true, Outline = true, Color = ESPNameColor, Visible = false}),
                Distance = createDrawing("Text", {Size = 13, Center = true, Outline = true, Color = Color3.fromRGB(200, 200, 200), Visible = false}),
                Health = createDrawing("Line", {Thickness = 2, Color = Color3.fromRGB(0, 255, 0), Visible = false}),
                Tracer = createDrawing("Line", {Thickness = 1, Color = ESPTracerColor, Visible = false}),
                HeadDot = createDrawing("Circle", {Thickness = 1, Filled = true, Color = Color3.fromRGB(255, 0, 0), Visible = false, Radius = 4}),
                Arrow = createDrawing("Triangle", {Thickness = 1, Filled = true, Color = Color3.fromRGB(0, 255, 128), Visible = false}),
            }
        end

        local d = Drawings[player]
        local size = char:GetExtentsSize()
        local scale = (size.Y * Camera.ViewportSize.Y) / (dist * 2) * 0.4
        local boxW, boxH = scale * 0.6, scale

        if onScreen then
            if ESPBox then
                d.Box.Size = Vector2.new(boxW, boxH)
                d.Box.Position = Vector2.new(pos.X - boxW/2, pos.Y - boxH/2)
                d.Box.Visible = true
            else
                d.Box.Visible = false
            end

            if ESPName then
                d.Name.Text = player.Name
                d.Name.Position = Vector2.new(pos.X, pos.Y + boxH/2 - 16)
                d.Name.Visible = true
            else
                d.Name.Visible = false
            end

            if ESPDistance then
                d.Distance.Text = math.floor(dist) .. " studs"
                d.Distance.Position = Vector2.new(pos.X, pos.Y + boxH/2 + 2)
                d.Distance.Visible = true
            else
                d.Distance.Visible = false
            end

            if ESPHealth then
                local hp = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                d.Health.From = Vector2.new(pos.X - boxW/2 - 5, pos.Y + boxH/2)
                d.Health.To = Vector2.new(pos.X - boxW/2 - 5, pos.Y + boxH/2 - (boxH * hp))
                d.Health.Color = Color3.fromRGB(255 - (hp * 255), hp * 255, 0)
                d.Health.Visible = true
            else
                d.Health.Visible = false
            end

            if ESPTracer then
                d.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                d.Tracer.To = Vector2.new(pos.X, pos.Y + boxH/2)
                d.Tracer.Visible = true
            else
                d.Tracer.Visible = false
            end

            if ESPHeadDot and headOnScreen then
                d.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
                d.HeadDot.Visible = true
            else
                d.HeadDot.Visible = false
            end

            d.Arrow.Visible = false
        else
            d.Box.Visible = false
            d.Name.Visible = false
            d.Distance.Visible = false
            d.Health.Visible = false
            d.Tracer.Visible = false
            d.HeadDot.Visible = false

            if ESPOffscreenArrows then
                local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                local dir = Vector2.new(pos.X - screenCenter.X, pos.Y - screenCenter.Y).Unit
                local arrowPos = screenCenter + dir * 200
                d.Arrow.PointA = arrowPos
                d.Arrow.PointB = arrowPos - dir * 15 + Vector2.new(-dir.Y, dir.X) * 8
                d.Arrow.PointC = arrowPos - dir * 15 + Vector2.new(dir.Y, -dir.X) * 8
                d.Arrow.Visible = true
            else
                d.Arrow.Visible = false
            end
        end

        if ESPChams then
            if not Highlights[player] then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = Color3.fromRGB(0, 255, 128)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Adornee = char
                highlight.Parent = CoreGui
                Highlights[player] = highlight
            else
                Highlights[player].Adornee = char
            end
        else
            if Highlights[player] then
                Highlights[player]:Destroy()
                Highlights[player] = nil
            end
        end
    end
end

