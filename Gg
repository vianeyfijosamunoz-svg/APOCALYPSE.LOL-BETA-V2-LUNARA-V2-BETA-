    pcall(function()
        if FighterController and FighterController.LocalFighter and FighterController.LocalFighter.EquippedItem then
            local item = FighterController.LocalFighter.EquippedItem
            local model = item.Model or item.Handle or item.Part
            if model and model:IsA("BasePart") then
                model.CFrame = Camera.CFrame * CFrame.new(VM_X, VM_Y, VM_Z) * CFrame.Angles(math.rad(VM_RotX), math.rad(VM_RotY), math.rad(VM_RotZ))
            end
        end
    end)
end

local function updateESP()
    if not ESPEnabled then
        for player, _ in pairs(Drawings) do
            removeDrawings(player)
        end
        return
    end

    for _, player in ipairs(plrs:GetPlayers()) do
        if player == LocalPlayer then
            removeDrawings(player)
            continue
        end

        if not isTargetValid(player) then
            removeDrawings(player)
            continue
        end

        local char = player.Character
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")

        if not root or not head or not humanoid then
            removeDrawings(player)
            continue
        end

        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)

        if not Drawings[player] then
            Drawings[player] = {
                Box = createDrawing("Square", {Thickness = 1, Filled = false, Visible = false}),
                Name = createDrawing("Text", {Size = 14, Center = true, Outline = true, Visible = false}),
                Distance = createDrawing("Text", {Size = 13, Center = true, Outline = true, Visible = false}),
                Health = createDrawing("Line", {Thickness = 2, Visible = false}),
                Tracer = createDrawing("Line", {Thickness = 1, Visible = false}),
                HeadDot = createDrawing("Circle", {Thickness = 1, Filled = true, Visible = false, Radius = 4}),
                Arrow = createDrawing("Triangle", {Thickness = 1, Filled = true, Visible = false}),
            }
        end

        local d = Drawings[player]
        local size = char:GetExtentsSize()
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        local scale = (size.Y * Camera.ViewportSize.Y) / (dist * 2) * 0.4
        local boxW, boxH = scale * 0.6, scale

        d.Box.Color = ESPBoxColor
        d.Name.Color = ESPNameColor
        d.Distance.Color = ESPDistanceColor
        d.Tracer.Color = ESPTracerColor
        d.HeadDot.Color = ESPHeadDotColor
        d.Arrow.Color = ESPArrowColor

        if onScreen then
            if ESPBox then
                d.Box.Size = Vector2.new(boxW, boxH)
                d.Box.Position = Vector2.new(pos.X - boxW/2, pos.Y - boxH/2)
                d.Box.Visible = true
            else
                d.Box.Visible = false
            end

            if ESPName then
                d.Name.Text = player.Name
                d.Name.Position = Vector2.new(pos.X, pos.Y + boxH/2 - 16)
                d.Name.Visible = true
            else
                d.Name.Visible = false
            end

            if ESPDistance then
                d.Distance.Text = math.floor(dist) .. " studs"
                d.Distance.Position = Vector2.new(pos.X, pos.Y + boxH/2 + 2)
                d.Distance.Visible = true
            else
                d.Distance.Visible = false
            end

            if ESPHealth then
                local hp = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                d.Health.From = Vector2.new(pos.X - boxW/2 - 5, pos.Y + boxH/2)
                d.Health.To = Vector2.new(pos.X - boxW/2 - 5, pos.Y + boxH/2 - (boxH * hp))
                d.Health.Color = Color3.fromRGB(255 - (hp * 255), hp * 255, 0)
                d.Health.Visible = true
            else
                d.Health.Visible = false
            end

            if ESPTracer then
                local originVector = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                pcall(function()
                    if FighterController and FighterController.LocalFighter and FighterController.LocalFighter.EquippedItem then
                        local item = FighterController.LocalFighter.EquippedItem
                        local part = item.Model or item.Handle or item.Part
                        if part and part:IsA("BasePart") then
                            local weaponScreenPos, weaponOnScreen = Camera:WorldToViewportPoint(part.Position)
                            if weaponOnScreen then
                                originVector = Vector2.new(weaponScreenPos.X, weaponScreenPos.Y)
                            end
                        end
                    end
                end)
                d.Tracer.From = originVector
                d.Tracer.To = Vector2.new(pos.X, pos.Y + boxH/2)
                d.Tracer.Visible = true
            else
                d.Tracer.Visible = false
            end

            if ESPHeadDot and headOnScreen then
                d.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
                d.HeadDot.Visible = true
            else
                d.HeadDot.Visible = false
            end

            d.Arrow.Visible = false
        else
            d.Box.Visible = false
            d.Name.Visible = false
            d.Distance.Visible = false
            d.Health.Visible = false
            d.Tracer.Visible = false
            d.HeadDot.Visible = false

            if ESPOffscreenArrows then
                local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                local dir = Vector2.new(pos.X - screenCenter.X, pos.Y - screenCenter.Y).Unit
                local arrowPos = screenCenter + dir * 200
                d.Arrow.PointA = arrowPos
                d.Arrow.PointB = arrowPos - dir * 15 + Vector2.new(-dir.Y, dir.X) * 8
                d.Arrow.PointC = arrowPos - dir * 15 + Vector2.new(dir.Y, -dir.X) * 8
                d.Arrow.Visible = true
            else
                d.Arrow.Visible = false
            end
        end

        if ESPChams then
            if not Highlights[player] then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = ESPChamsColor
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Adornee = char
                highlight.Parent = CoreGui
                Highlights[player] = highlight
            else
                Highlights[player].Adornee = char
                Highlights[player].FillColor = ESPChamsColor
            end
        else
            if Highlights[player] then
                Highlights[player]:Destroy()
                Highlights[player] = nil
            end
        end
    end
end

