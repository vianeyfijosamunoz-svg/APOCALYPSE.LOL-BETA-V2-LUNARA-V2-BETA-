RunService.RenderStepped:Connect(function()
    updateESP()

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if hum then
            if getgenv().GodMode then
                hum.MaxHealth = math.huge
                hum.Health = math.huge
            end
            hum.WalkSpeed = MiscSpeedBoost
            if MiscJumpPower ~= 50 then
                hum.JumpPower = MiscJumpPower
            end
            if MiscHipHeight ~= 2 then
                hum.HipHeight = MiscHipHeight
            end
            if getgenv().AntiSit then
                hum.Sit = false
            end
        end

        if getgenv().Noclip then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        if SpinbotEnabled and hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(SpinbotSpeed * 0.05), 0)
        end

        -- LÓGICA ANTI-AIM BROKEN (HRP FIJO, EXTREMIDADES Y TORSO ROTOS)
        if AntiAimEnabled and hrp then
            if not frozenRootPosition then
                frozenRootPosition = hrp.CFrame
            end
            
            -- Bloquear por completo la posición y velocidad del HumanoidRootPart para que no se mueva NUNCA
            hrp.CFrame = frozenRootPosition
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            -- Desincronizar y romper las articulaciones visuales (Motor6D) agresivamente
            for _, joint in ipairs(char:GetDescendants()) do
                if joint:IsA("Motor6D") then
                    local t = tick() * (AntiAimSpeed * 0.01)
                    if AntiAimMode == "Aggressive Spin" then
                        joint.C0 = joint.C0 * CFrame.Angles(math.sin(t) * 0.5, math.cos(t) * 0.8, 0)
                    elseif AntiAimMode == "Broken Jitter" then
                        local jit = math.rad(math.random(-AntiAimIntensity * 10, AntiAimIntensity * 10))
                        joint.C0 = joint.C0 * CFrame.Angles(jit, jit, jit)
                    elseif AntiAimMode == "Psychotic" then
                        joint.C0 = joint.C0 * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), 0)
                    elseif AntiAimMode == "Inverted" then
                        joint.C0 = joint.C0 * CFrame.Angles(math.pi, math.sin(t) * AntiAimIntensity, 0)
                    end
                end
            end
        else
            frozenRootPosition = nil
        end
    end
end)

