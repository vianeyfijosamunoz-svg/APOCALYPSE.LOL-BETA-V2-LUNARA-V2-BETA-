                end
            end
        else
            ueLastCycle = now
        end
    else
        hrp.CFrame = CFrame.new(targetRoot.Position.X, 5000000, targetRoot.Position.Z)
        hrp.AssemblyLinearVelocity = Vector3.new(0, currentSpeed, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end)

