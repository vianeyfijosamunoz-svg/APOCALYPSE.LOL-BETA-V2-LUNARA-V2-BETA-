task.spawn(function()
    local lastTarget = nil
    local lastTargetPos = nil

    while true do
        task.wait()

        if Options.RagebotKeybind and Options.RagebotKeybind:GetState() then
            isRagebotOn = true
        end

        if not isRagebotOn then
            StatusLabel.Visible = false
            lastTarget = nil
            lastTargetPos = nil
            isInVoidPhase = false
            continue
        end

        StatusLabel.Visible = true

        local char = LocalPlayer.Character
        if not char then
            StatusLabel.Text = "VOID - No Character"
            isInVoidPhase = false
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid then
            StatusLabel.Text = "VOID - No HRP"
            isInVoidPhase = false
            continue
        end

        if tick() - lastKillTime < KillDelay then
            StatusLabel.Text = "KILL DELAY..."
            continue
        end

        local hasWeapon = false
        if FighterController and FighterController.LocalFighter then
            local item = FighterController.LocalFighter.EquippedItem
            if item then
                local success, objId = pcall(function() return item:Get("ObjectID") end)
                if success and objId then
                    hasWeapon = true
                end
            end
        end

        if not hasWeapon then
            StatusLabel.Text = "WAITING FOR WEAPON..."
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            isInVoidPhase = false
            continue
        end

        local closestManipTarget = nil
        local closestManipDist = 7.5

        if isManipulacionOn then
            for _, player in ipairs(plrs:GetPlayers()) do
                if isTargetValid(player) then
                    local pRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if pRoot then
                        local dist = (hrp.Position - pRoot.Position).Magnitude
                        if dist <= closestManipDist then
                            closestManipDist = dist
                            closestManipTarget = player
                        end
                    end
                end
            end
        end

        local targetPlayer, targetRoot, targetHead = getClosestTarget(math.huge)

        if not targetPlayer or not targetRoot or not targetHead then
            if lastTarget then
                lastKillTime = tick()
            end
            if not (isManipulacionOn and closestManipTarget) then
                StatusLabel.Text = "VOID - No Target"
            end
            lastTarget = nil
            lastTargetPos = nil
            hrp.AssemblyLinearVelocity = Vector3.zero
            isInVoidPhase = false
            continue
        end

        if AntiCounterEnabled and targetRoot then
            local targetVel = targetRoot.AssemblyLinearVelocity.Magnitude
            local myY = hrp.Position.Y
            local targetY = targetRoot.Position.Y
            local isCountering = targetVel > 80 or math.abs(targetY - myY) > 15
            if isCountering and not (isManipulacionOn and closestManipTarget) then
                StatusLabel.Text = "ANTI-COUNTER → " .. targetPlayer.Name
            end
        end

        local predictedPos = targetRoot.Position
        lastTarget = targetPlayer
        lastTargetPos = targetRoot.Position

        isInVoidPhase = false

        local prefix = customStatusPrefix
        if randomStatusMode then
            prefix = randomWords[math.random(1, #randomWords)]
        end

        if isManipulacionOn and closestManipTarget then
            StatusLabel.Text = prefix .. ": MANIPULATING (" .. closestManipTarget.Name .. ")"
        else
            StatusLabel.Text = prefix .. " → " .. targetPlayer.Name
        end

        local attackStart = tick()
        while isRagebotOn and (tick() - attackStart < 0.95) do
            if not string.find(StatusLabel.Text, "→") and not string.find(StatusLabel.Text, "MANIPULATING") then break end

            local currentTargetPlayer, currentTargetRoot, currentTargetHead = getClosestTarget(math.huge)
            if not currentTargetPlayer or not currentTargetRoot or not currentTargetHead then break end

            local currentPredictedPos = currentTargetRoot.Position
            local offset = Vector3.new(rageOffsetX, rageOffsetY, rageOffsetZ)
            local finalCF = CFrame.new(currentPredictedPos + offset) * CFrame.Angles(math.rad(-90), 0, 0)
            
            if (hrp.Position - finalCF.Position).Magnitude > 0 then
                hrp.CFrame = finalCF
            end

            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            if FighterController and FighterController.LocalFighter then
                local item = FighterController.LocalFighter.EquippedItem
                if item and util and enum then
                    local originPos = hrp.Position
                    local targetPos = currentTargetHead.Position

                    local randomOffset = Vector3.new(
                        (math.random() - 0.5) * 0.035,
                        (math.random() - 0.5) * 0.035,
                        (math.random() - 0.5) * 0.035
                    )

                    local aimCF = CFrame.lookAt(originPos, targetPos + randomOffset)
                    local targetCF = currentTargetHead.CFrame
                    local objSpaceHeadOffset = currentTargetHead.CFrame:ToObjectSpace(CFrame.new(targetPos + randomOffset))

                    local cameradata = {}
                    cameradata[utf8.char(1)] = {
                        [utf8.char(0)] = util:EncodeCFrame(aimCF),
                        [utf8.char(1)] = util:EncodeCFrame(targetCF),
                        [utf8.char(2)] = currentTargetHead,
                        [utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset)
                    }

                    pcall(function()
                        repS.Remotes.Replication.Fighter.UseItem:FireServer(
                            item:Get("ObjectID"),
                            enum:ToEnum("StartShooting"),
                            cameradata,
                            nil
                        )
                    end)
                end
            end

            task.wait()
        end

        if isRagebotOn and VoidPhaseEnabled then
            isInVoidPhase = true
            StatusLabel.Text = "VOID PHASE"
            local voidStartTime = tick()

            while isRagebotOn and (tick() - voidStartTime < 0.05) do
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 5000000, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 999999999, 0)
                hrp.AssemblyAngularVelocity = Vector3.zero
                task.wait()
            end

            isInVoidPhase = false
        end
    end
end)
