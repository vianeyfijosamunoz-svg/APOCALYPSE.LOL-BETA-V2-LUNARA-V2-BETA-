        undergroundAnchorPos = hrp.Position
    end

    if tick() - undergroundTimer >= 0 then
        undergroundTimer = tick()
        local randomX = math.random(-35, 35)
        local randomZ = math.random(-35, 35)
        currentUndergroundOffset = Vector3.new(randomX, -5, randomZ)
    end

    local targetPos = undergroundAnchorPos + currentUndergroundOffset
    hrp.CFrame = CFrame.new(targetPos) * (hrp.CFrame - hrp.CFrame.Position)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end)

