    if Drawings[player] then
        for _, d in pairs(Drawings[player]) do
            pcall(function() d:Remove() end)
        end
        Drawings[player] = nil
    end
    if Highlights[player] then
        pcall(function() Highlights[player]:Destroy() end)
        Highlights[player] = nil
    end
end

local function updateWeaponChams()
    if not WeaponChamsEnabled then return end
    
    pcall(function()
        if FighterController and FighterController.LocalFighter then
            local item = FighterController.LocalFighter.EquippedItem
            if item then
                local model = item.Model or item.Handle or item.Part
                if model then
                    for _, desc in ipairs(model:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            local matEnum = Enum.Material[WeaponChamsMaterial] or Enum.Material.Neon
                            desc.Material = matEnum
                            desc.Color = WeaponChamsColor
                        end
                    end
                end
            end
        end
    end)
end

local function updateViewmodel()
